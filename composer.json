{
  "name": "moroz1999/zxmusic-converter",
  "description": "Small frontend for converting various ZX Spectrum native music formats to mp3",
  "minimum-stability": "stable",
  "license": "Unlicense",
  "require-dev": {
    "vimeo/psalm": "^6"
  },
  "require": {
    "ext-zlib": "*",
    "php-di/php-di": "^7.0",
    "ext-zip": "*",
    "ext-libxml": "*",
    "ext-simplexml": "*",
    "ext-fileinfo": "*",
    "monolog/monolog": "^3.0"
  },
  "autoload": {
    "psr-4": {
      "ZxMusic\\": "music_back/src/"
    }
  },
  "config": {
    "vendor-dir": "music_back/vendor"
  }
}
